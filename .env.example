# 1. Configuración Básica de Django
SECRET_KEY=carmesi-secreto-municipal-la-serena-2026-super-seguro
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# 2. Configuración Base de Datos (Modo Dual: SQLite Local vs Amazon RDS / MySQL)
# Para desarrollo local deje USE_MYSQL=False (usa db.sqlite3 automáticamente)
USE_MYSQL=False
DB_NAME=matriz_sgr_db
DB_USER=sgr_user
DB_PASSWORD=sgr_password2026!
DB_HOST=localhost                       # Para AWS RDS: sgr-mysql.xxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306                            # Puerto estándar MySQL (o 2608 según topología)

# 3. Almacenamiento Cloud de Evidencias Fotográficas (Amazon S3 con Boto3)
# Documentado en páginas 80-84 de la Documentación Oficial de Arquitectura SGR
# Para desarrollo local deje USE_S3=False (almacena en carpeta local /media/)
USE_S3=False
AWS_ACCESS_KEY_ID=tu_aws_access_key_aqui
AWS_SECRET_ACCESS_KEY=tu_aws_secret_key_aqui
AWS_STORAGE_BUCKET_NAME=matriz-sgr-evidencias-laserena
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=matriz-sgr-evidencias-laserena.s3.amazonaws.com

# 4. Diagnóstico Rápido de AWS en la Terminal:
# Ejecute: python manage.py test_aws